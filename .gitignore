# 构建产物
android/build/
dist/*.apk
dist/*.zip

# 签名证书与密码：只在本地保留，绝不提交
android/keystore.jks
android/.keystore-pass
*.jks
*.keystore

# GitHub token（发布脚本用）
.gh-token

# 安装包（根目录与构建产物不入库，只保留 apk/ 下供 CDN 镜像的那份）
*.apk
!apk/
!apk/*.apk

# 编译中间件
*.class
*.dex
classes.dex

# 本地截图与临时文件
__shot-*.html
*.local

# 系统与编辑器
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# WorkBuddy 本地工作目录
.workbuddy/

# 第三方库是脚本拉下来的（16MB 二进制，不适合进仓库）
# 换机器时先跑：python android/tools/fetch-deps.py
android/libs/*.aar
android/libs/*.jar
